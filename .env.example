# Copy to .env and fill in. .env is git-ignored; never commit real values.

# --- Existing app ---
MONGO_CONNECTION_STRING=mongodb://localhost:27018/
SECRET_KEY=change-me

# --- Nexus Quant (read-only). Dev: the Docker MySQL from docker-compose.dev.yml.
#     Production: 127.0.0.1 + the autossh tunnel's local port. ---
NQ_DB_HOST=127.0.0.1
NQ_DB_LOCAL_PORT=3308
NQ_DB_NAME=jhsdb
NQ_DB_USER=nq_ro
NQ_DB_PASS=dev_ro_pass

# Write-back user (UPDATE on task end_date only; used from Phase 4)
NQ_WB_USER=nq_wb
NQ_WB_PASS=dev_wb_pass

# --- Local MongoDB for development (docker-compose.dev.yml) ---
MONGO_URL=mongodb://localhost:27018/

# --- SMTP (digest emails, Phase 4) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=timesnap@example.invalid
